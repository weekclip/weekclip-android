<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Nothing else is declared yet, on purpose. Permissions this skeleton does
       not exercise (POST_NOTIFICATIONS, READ_MEDIA_*, FOREGROUND_SERVICE_*)
       arrive with the code that needs them:
         · media picker + READ_MEDIA_VISUAL_USER_SELECTED  → Phase 5
         · foreground service + notifications for upload    → Phase 5 (D8)
       Declaring them early ships permissions nothing uses and, for READ_MEDIA_*,
       trips lint's SelectedPhotoAccess check with no code to fix. -->

  <application
    android:name=".WeekclipApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Weekclip"
    android:usesCleartextTraffic="false">

    <!-- launchMode=singleTask is required by the OAuth round trip, not a
         preference. The Custom Tab opens inside this task; the redirect must
         come back to the SAME MainActivity instance (via onNewIntent) or it
         reaches a fresh ViewModel that never started the sign-in it is being
         handed the answer to. singleTask also clears the tab off the stack, so
         `back` from the app does not return to a spent consent page. -->
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.Weekclip">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- The OAuth redirect target. Must stay byte-identical to
           SupabaseOAuth.REDIRECT_URI and to the entry in Supabase Auth's
           "Redirect URLs" allow list — GoTrue compares the string.

           No android:autoVerify here, and none is possible: verification is for
           https App Links against a domain, and this is a private-use scheme
           (RFC 8252 §7.1). Any app may claim it, which is exactly why the
           exchange is bound by PKCE — see core/auth/PkceChallenge.kt. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="cc.sunglint.weekclip" android:host="auth-callback" />
      </intent-filter>

      <!-- App Links intent-filters for https://weekclip.com (PRD-0008 D4/N2)
           are still held back on 148.4b: they verify against the release
           signing certificate, and assetlinks.json carries no fingerprint yet.
           Declaring them now would give users a chooser dialog instead of a
           verified link. MainActivity.handleIntent already routes them — the
           parser and the gate are live the day the filter lands. -->
    </activity>

  </application>

</manifest>
