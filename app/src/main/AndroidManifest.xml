<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- Nothing else is declared yet, on purpose. Permissions this skeleton does
       not exercise (POST_NOTIFICATIONS, READ_MEDIA_*, FOREGROUND_SERVICE_*)
       arrive with the code that needs them:
         · media picker + READ_MEDIA_VISUAL_USER_SELECTED  → Phase 5
         · foreground service + notifications for upload    → Phase 5 (D8)
       Declaring them early ships permissions nothing uses and, for READ_MEDIA_*,
       trips lint's SelectedPhotoAccess check with no code to fix. -->

  <application
    android:name=".WeekclipApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.Weekclip"
    android:usesCleartextTraffic="false">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:theme="@style/Theme.Weekclip">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- App Links intent-filters (PRD-0008 D4/N2) are added in Phase 3,
           together with the assetlinks.json that weekclip.com must serve.
           Declaring them before the domain verifies would give users a
           chooser dialog instead of a verified link. -->
    </activity>

  </application>

</manifest>
