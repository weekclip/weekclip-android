<?xml version="1.0" encoding="utf-8"?>
<!--
  PRD-0008 D3: no string in this file may name a way to pay. The app can say a
  studio is out of room; it may not say what to do about it.
  `scripts/check-no-payment-strings.sh` checks this file first, and CI runs that
  script before it installs a toolchain.
-->
<resources>
  <string name="app_name">Weekclip</string>

  <string name="dashboard_title">Studios</string>
  <string name="dashboard_empty">No studios yet.</string>

  <string name="role_owner">Owner</string>
  <string name="role_editor">Editor</string>
  <string name="role_viewer">Viewer</string>
  <string name="role_member">Member</string>

  <string name="action_retry">Try again</string>

  <!-- The first gate (PRD-0008 D4). One way in, deliberately: the wireframe's
       notes are explicit that a second option makes returning users stop and
       ask which one they used last time. -->
  <string name="login_title">Sign in to WeekClip</string>
  <string name="login_subtitle">Your studios, on this device.</string>
  <string name="login_google">Continue with Google</string>
  <string name="login_connecting">Finish signing in in your browser.</string>
  <string name="login_return_to_link">We\'ll take you back to what you opened.</string>
  <string name="login_error_denied">Sign-in was not completed.</string>
  <string name="login_error_failed">Could not sign in. Please try again.</string>
  <string name="login_error_not_configured">This build cannot sign in.</string>

  <!-- PRD-0008 D6①. "Update" here is about the app binary, not about capacity
       or anything you could pay for — D3 still holds in this file. -->
  <string name="update_required_title">Update Weekclip to continue</string>
  <string name="update_required_body">This version is no longer supported.</string>
  <string name="update_required_action">Open the store</string>

  <string name="error_offline">You appear to be offline.</string>
  <string name="error_timeout">The server took too long to respond.</string>
  <string name="error_unauthorized">Your session has ended. Sign in again.</string>
  <string name="error_not_found">That is no longer available.</string>
  <string name="error_generic">Something went wrong. Please try again.</string>
</resources>
