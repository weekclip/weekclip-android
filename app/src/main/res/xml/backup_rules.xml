<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 backup rules. android:allowBackup is false, so nothing is
     backed up; this file exists because the manifest references it. -->
<full-backup-content>
  <exclude domain="sharedpref" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
</full-backup-content>
